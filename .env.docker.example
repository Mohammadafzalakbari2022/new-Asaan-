# Local Docker environment for the Asaan online store.
# Copy to .env.docker (the copy is git-ignored) and adjust values here.
# Every value below is read by docker-compose.yml and handed to the app
# container as environment variables — nothing in the source code needs editing.

APP_NAME=Akbari Development Group
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=1.0.14
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=asaan_store
DB_USERNAME=asaan_store
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"

CARTXIS_THEME_DIRECTORY_URL=https://cartxis.com/api
CARTXIS_THEME_API_KEY=

# These create the admin login (seeded on first start).
CARTXIS_ADMIN_NAME=Admin
CARTXIS_ADMIN_EMAIL=admin@example.com
CARTXIS_ADMIN_PASSWORD=change_this_password

# Port nginx listens on INSIDE the container (leave as 80; compose maps it to 8080).
PORT=80